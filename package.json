{
  "name": "trickle-react",
  "version": "0.1.0",
  "description": "React hooks for streaming structured output from LLMs — useStreamingObject(schema, startStream) gives you a typed, progressively-filling object with per-field loading status. Built on trickle-json.",
  "type": "module",
  "license": "MIT",
  "author": "Himanshu Sharma",
  "sideEffects": false,
  "keywords": [
    "react",
    "hooks",
    "streaming",
    "llm",
    "ai",
    "openai",
    "anthropic",
    "structured-output",
    "partial-json",
    "useobject",
    "zod",
    "trickle-json",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H1manshu01/trickle-react.git"
  },
  "homepage": "https://github.com/H1manshu01/trickle-react#readme",
  "bugs": {
    "url": "https://github.com/H1manshu01/trickle-react/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "size": "size-limit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "trickle-json": "^0.1.1"
  },
  "peerDependencies": {
    "coerce-json": ">=0.1",
    "react": ">=18",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "coerce-json": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "coerce-json": "^0.1.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "zod": "^3.24.1"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "vite": "^6.4.4"
  },
  "size-limit": [
    {
      "name": "core (useStreamingObject + useStreamingList)",
      "path": "dist/index.js",
      "limit": "4 kB",
      "ignore": ["react", "react-dom", "trickle-json"]
    }
  ],
  "engines": {
    "node": ">=18"
  }
}
